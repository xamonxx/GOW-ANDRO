<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon emblem (also the monochrome layer): a sky-blue omega with two blade marks,
     inside the adaptive icon's 66 dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Soft halo under the omega. -->
    <path
        android:pathData="M40,76H49V68A16,16 0,1 1,59 68V76H68"
        android:strokeColor="#4038BDF8"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- The omega. -->
    <path
        android:pathData="M40,76H49V68A16,16 0,1 1,59 68V76H68"
        android:strokeColor="#FF38BDF8"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Highlight along its top. -->
    <path
        android:pathData="M45,45A12,12 0,0 1,63 45"
        android:strokeColor="#FFBAE6FD"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- Blade marks. -->
    <path
        android:pathData="M29,46L37,40M79,46L71,40"
        android:strokeColor="#FF7DD3FC"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
